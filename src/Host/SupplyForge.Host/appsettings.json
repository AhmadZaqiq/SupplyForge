{
  "ConnectionStrings": {
    "SupplyForge": "Server=localhost,1433;Database=SupplyForge;User Id=sa;Password=SupplyForge_Dev_2026!;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=false"
  },
  "Auth": {
    "Issuer": "supplyforge",
    "Audience": "supplyforge-api",
    "AccessTokenSecret": "SupplyForge_Dev_AccessTokenSecret_ChangeMe_0123456789"
  },
  "RateLimit": {
    // SEC-04 / PLT-012 (A0-2): in-memory, per-instance (MOD-8: no Redis).
    // Override with env vars: RateLimit__AuthIpLimit, RateLimit__AuthWindow, ...
    "AuthWindow": "00:05:00",
    "AuthIpLimit": 30,
    "AuthAccountLimit": 10,
    // Off by default: no reverse proxy in the A0 topology. Enabling without a
    // trusted proxy in front would let callers spoof X-Forwarded-For.
    "EnableForwardedHeaders": false,
    "ForwardLimit": 1,
    "TrustedProxies": []
  },
  "Email": {
    // ADR-008: Fake | Disabled (default Fake in dev; Disabled = visible
    // pending only, PLT-051). "Smtp" is rejected at startup until the real
    // adapter exists (ADR-008 follow-up). Exact keys are recommendations.
    "Mode": "Fake",
    // Fake-adapter failure injection for tests (ADR-008: the fake must
    // exercise the queue/retry/status paths). Never enable against traffic.
    "SimulateFailures": false,
    // Total attempts including the inline first one; then Failed (dead-letter,
    // visible per INT-003 / PLT-052).
    "MaxAttempts": 3,
    // Exponential backoff + jitter between attempts (INT-003).
    "RetryBaseDelay": "00:00:05",
    "RetryMaxDelay": "00:05:00",
    "RetryInterval": "00:00:05",
    // INT-004: one adapter call is bounded; a timeout is recorded as a
    // normal delivery failure instead of hanging the retry worker.
    "SendTimeout": "00:00:30"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
